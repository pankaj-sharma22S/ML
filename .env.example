# ==============================================================================
# AMEA - Autonomous ML Engineer & Knowledge Platform
# Environment Configuration Template (.env.example)
#
# Copy this file to '.env' in the project root:
#   cp .env.example .env
#
# DO NOT commit your real '.env' file containing secret keys to Git.
# ==============================================================================

# --- LLM Provider Selection ("openrouter" or "ollama") ---
LLM_PROVIDER=openrouter

# --- Provider A: OpenRouter (Cloud LLM Gateway) ---
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Provider B: Ollama (Local LLM Server) ---
# Start Ollama locally with: ollama serve
# Pull your desired model: ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Supabase Authentication & PostgreSQL Persistence (Optional / Cloud Mode) ---
# In local development, AMEA seamlessly uses local SQLite fallback if Supabase is unconfigured.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=dev-secret-key-change-in-production

# --- Server Runtime Options ---
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
